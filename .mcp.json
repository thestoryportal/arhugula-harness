{
  "mcpServers": {
    "notebooklm": {
      "type": "stdio",
      "command": "notebooklm-mcp",
      "args": [
        "--transport",
        "stdio"
      ]
    },
    "graft": {
      "command": "graft",
      "args": [
        "mcp"
      ]
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--no-install",
        "context7-mcp"
      ]
    }
  }
}
