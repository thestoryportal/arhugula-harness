{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/tools/hooks/codex-session-start.sh\"",
            "statusMessage": "Registering session lease and loading Codex posture",
            "timeout": 105
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_tool_use_policy.py\"",
            "statusMessage": "Checking project boundaries",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/tools/hooks/precmd-clear-cache.sh\"",
            "statusMessage": "Clearing stale caches",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/codex_hook_adapter.py\" pre-commit",
            "statusMessage": "Checking commit type safety",
            "timeout": 130
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/tools/hooks/permission-guard.sh\"",
            "statusMessage": "Applying autonomous-loop guardrails",
            "timeout": 20
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/permission_request.py\"",
            "statusMessage": "Reviewing permission request",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/tools/hooks/permission-guard.sh\"",
            "statusMessage": "Applying autonomous-loop guardrails",
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/tools/hooks/precompact-checkpoint.sh\"",
            "statusMessage": "Checkpointing before compaction",
            "timeout": 30
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/tools/hooks/postcompact-reinject.sh\"",
            "statusMessage": "Restoring compacted context",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/tools/roadmap-audit/post-merge-refresh.sh\"",
            "statusMessage": "Checking roadmap refresh obligations",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/codex_hook_adapter.py\" post-tool-use",
            "statusMessage": "Capturing failures and linting edits",
            "timeout": 35
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/tools/hooks/prompt-context.sh\"",
            "timeout": 12
          },
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/tools/hooks/skill-activation-check.sh\"",
            "timeout": 12
          },
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/tools/hooks/prompt-lint.sh\"",
            "timeout": 12
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/tools/hooks/subagent-validate.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/tools/hooks/subagent-validate.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/tools/hooks/codex-session-end.sh\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/stop_gate.py\"",
            "statusMessage": "Checking stop posture",
            "timeout": 90
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/tools/hooks/stop-gate.sh\"",
            "statusMessage": "Linting before stop",
            "timeout": 45
          },
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/tools/hooks/git-arc-guard.sh\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/tools/hooks/stop-loop.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
