# .gitignore — H_T workspace. Authority: Bootstrap Runbook §4.4.4.
# Excludes runtime-mutable state + build artifacts. Does NOT exclude source,
# tests, pyproject.toml, *.md, or the Phase 7 directive (all version-controlled).

# Runtime state — .harness/ is created at runtime by Bash append-write
# (Meta-Architecture §10.1.3); state ledger + observability DB must not be committed.
.harness/state.jsonl
.harness/observability.db
.harness/*.db
.harness/*.db-journal
.harness/*.db-wal
.harness/*.db-shm

# Python build artifacts
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Tool caches
.pytest_cache/
.ruff_cache/
.pyright/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

# Operator-local secrets (loaded by justfile via dotenv)
.env
.env.local

# Operator-local runtime config (copied from harness.toml.example + edited
# with machine-specific absolute paths). Not committed.
harness.toml

# IDE / editor
.vscode/
.idea/
*.swp
.DS_Store

# Coverage
.coverage
htmlcov/
coverage.xml

# Skill-eval run artifacts (regenerable; eval sets in .claude/skills/*/evals/ are version-controlled)
.claude/skills/*-workspace/

# Claude Code runtime locks
.claude/scheduled_tasks.lock

# Codex project-local worktrees. Codex-managed app worktrees live under
# $CODEX_HOME/worktrees; this path is for operator-created repo-local worktrees.
.codex-worktrees/

# Operator dashboard ephemeral Pages build dir (R-XI-01; regenerated by dashboard-deploy.yml)
tools/dashboard/public/

# Dashboard design discipline — local working copies of the 4 design skills the
# 4-skill loop consults (~88MB; the loop invokes the *installed* skills at
# ~/.claude/skills, these are reference clones only — do NOT vendor them).
dashboard-design/impeccable/
dashboard-design/ui-ux-pro-max-skill/

# Local design-skill installs at the project .claude/skills/ (reference clones
# installed via the library). NOTE: the council/* skills under .claude/skills/
# ARE version-controlled — only these 4 design-skill reference clones are not.
.claude/skills/frontend-design/
.claude/skills/impeccable/
.claude/skills/taste-skill/
.claude/skills/ui-ux-pro-max/

# Superseded Mustard-era dashboard scratch (canonical dashboard = Almanac Noir,
# generated by tools/dashboard/generate.py; dashboard-design/DISCIPLINE.md is the
# tracked doc — these two reappear as local scratch from design-skill runs).
dashboard-design/DESIGN.md
dashboard-design/mustard_editorial_kit.html
dashboard-design/taste-skill/
dashboard-design/frontend-design/
# impeccable live-mode local recovery state (live-auto/RUNBOOK.md §6 — not source).
.impeccable/
# 4-skill loop run logs + generated design-candidate HTML (regenerable outputs).
tools/dashboard/live-auto/_skillchain-logs/
tools/dashboard/candidates/

# Hook-written local checkpoints (U-HK-05 pre-compaction snapshots)
.harness/.checkpoints/

# Hook-written session issue log (U-HK-07)
.harness/session-issues.jsonl

# Loop-mode runtime artifacts (U-HK-11): the active-marker + append-only ledger
# are transient per-run state, written only while loop mode is on. Never tracked.
.harness/.loop-active
.harness/loop_status.md
.harness/.loop-iter
.harness/.loop-halt

# Reference docs (vendored clones + agent-knowledge corpora, third-party licenses) —
# read-only learning material, not tracked in harness history (also keeps them out of lint).
ai-docs/

# Generated knowledge-graph artifacts from the understand-anything plugin (regenerable).
.understand-anything/
**/.understand-anything/

# R-IF-112 semantic overlay (tools/semantic_overlay) — regenerable build artifacts, not tracked.
tools/semantic_overlay/overlay.json
**/.understand-anything/*.overlay.json

# TTS audio cache (ephemeral; not part of the reorg)
.claude/audio/
