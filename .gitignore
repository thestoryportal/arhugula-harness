# .gitignore — H_T workspace. Authority: Bootstrap Runbook §4.4.4.
# Excludes runtime-mutable state + build artifacts. Does NOT exclude source,
# tests, pyproject.toml, *.md, or the Phase 7 directive (all version-controlled).

# Runtime state — .harness/ is created at runtime by Bash append-write
# (Meta-Architecture §10.1.3); state ledger + observability DB must not be committed.
.harness/state.jsonl
.harness/state.jsonl.lock
# B-47 item (e) full-entry audit sidecar — carries ORIGINAL redaction-token
# raw values (PII/secrets); must never be committed. Unanchored: the sidecar
# lands beside WHATEVER directory PathBindingConfig places the state ledger
# in, not only .harness/ (codex rounds 5+7, PR B1).
audit-entries.jsonl
audit-entries.jsonl.lock
.harness/index.json
.harness/observability.db
.harness/*.db
.harness/*.db-journal
.harness/*.db-wal
.harness/*.db-shm
# R-FS-1 E-impl-2 (U-RT-122): durable WAL segment-log engine pause/resume state,
# written at runtime under repository_root by WALSegmentEnginePauseResumeSubstrate.
.harness/engine-recovery-segments/
routing_manifest/

# B-40: cross-process ledger advisory-lock sidecars (harness_is.cross_process_ledger_lock),
# created next to any canonical ledger path (state.jsonl.lock, memory_ops.jsonl.lock, etc).
.harness/**/*.lock

# Python build artifacts
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Tool caches
.pytest_cache/
.ruff_cache/
.pyright/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

# Operator-local secrets (loaded by justfile via dotenv)
.env
.env.local

# Operator-local runtime config (copied from harness.toml.example + edited
# with machine-specific absolute paths). Not committed.
harness.toml
harness.selfhosted.local.toml

# IDE / editor
.vscode/
.idea/
*.swp
.DS_Store

# Coverage
.coverage
htmlcov/
coverage.xml

# Skill-eval run artifacts (regenerable; eval sets in .claude/skills/*/evals/ are version-controlled)
.claude/skills/*-workspace/

# Claude Code runtime locks
.claude/scheduled_tasks.lock

# Codex project-local worktrees. Codex-managed app worktrees live under
# $CODEX_HOME/worktrees; this path is for operator-created repo-local worktrees.
.codex-worktrees/

# Hook-written local checkpoints (U-HK-05 pre-compaction snapshots)
.harness/.checkpoints/

# Hook-written session issue log (U-HK-07)
.harness/session-issues.jsonl

# Loop-mode runtime artifacts (U-HK-11): the active-marker + append-only ledger
# are transient per-run state, written only while loop mode is on. Never tracked.
.harness/.loop-active
.harness/loop_status.md
.harness/.loop-iter
.harness/.loop-halt
.harness/codex_loop_state.json

# Reference docs (vendored clones + agent-knowledge corpora, third-party licenses) —
# read-only learning material, not tracked in harness history (also keeps them out of lint).
ai-docs/

# Design-skill reference clones (vendored, not harness source; keeps them out of lint too).
dashboard-design/

# Generated knowledge-graph artifacts from the understand-anything plugin (regenerable).
.understand-anything/
**/.understand-anything/

# R-IF-112 semantic overlay (tools/semantic_overlay) — regenerable build artifacts, not tracked.
tools/semantic_overlay/overlay.json
**/.understand-anything/*.overlay.json

# TTS audio cache (ephemeral; not part of the reorg)
.claude/audio/

# Local, deliberately-untracked operator working trees (untracked since 2026-06-18;
# accidentally swept into PR #774 by a `git add -A`, untracked again here). These are
# local design/agent scratch + tooling, NOT harness source (out-of-family Codex [P2]).
# Un-ignore deliberately if any should become tracked.
.agents/
!.agents/
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/codex-autonomous-loop/
!.agents/skills/codex-autonomous-loop/**
.codex/agents/
.claude/agents/
