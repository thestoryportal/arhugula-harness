  "cards": [
    {
      "dot": "cyan",
      "title": "Audit is the load-bearing discipline",
      "items": [
        "session-start.sh recomputes HEAD + open PRs + fork docs + retirement batch into workspace_state_hash",
        "Match or a terminating-refresh fixed point proceeds; any other mismatch halts before edits",
        "The prompt hooks re-inject the next action on every message",
        "UserPromptSubmit scripts by name: prompt-context.sh, skill-activation-check.sh, prompt-lint.sh (plus graft-hooks.cjs prompt)"
      ]
    },
    {
      "dot": "amber",
      "title": "Reservation before build",
      "items": [
        "selectable exit 0 = head free; exit 1 = show state, resume own pending/open arc or re-derive",
        "arc_disjoint_check must print disjoint: before reserve; CONFLICT never reserves",
        "phase edges queue start/end and execute start are recorded only for a reserved arc"
      ]
    }
  ]
