  "cards": [
    {
      "dot": "cyan",
      "title": "Every gate has two exits",
      "items": [
        "SessionStart audit: hash match → derive; mismatch → DRIFT halt",
        "Codex round (pre-PR): exit 0 APPROVE → gh pr create; exit 1 BLOCK → absorb, next round",
        "PR CI: green → merge-gate; red → fix and re-poll (drawn in the Phase C drill-down)",
        "merge-gate: all 3 APPROVE → door; any BLOCK or split → fix, re-run the Codex round, re-gate, capped at 10"
      ]
    },
    {
      "dot": "rose",
      "title": "The door is the only merge",
      "items": [
        "safe-merge.sh wraps merge_door.py; the only merge string is gh pr merge --squash --match-head-commit",
        "One held lease spans squash-merge, the merge SHA's main CI, and the terminating refresh PR",
        "Exit 3 = blocked (DEFERRED-HIL row names just merge-door-unblock), 4 = re-gate, 5 = budget exhausted"
      ]
    },
    {
      "dot": "amber",
      "title": "Lifecycle hooks off the main path",
      "items": [
        "PreCompact precompact-checkpoint.sh · PostCompact postcompact-reinject.sh",
        "PostToolUseFailure + StopFailure capture-failure.sh · SessionEnd session-end-cleanup.sh",
        "PermissionRequest permission-guard.sh (same guard as PreToolUse *) · PostToolUse Bash post-merge-refresh.sh advisory after every Bash call"
      ]
    },
    {
      "dot": "emerald",
      "title": "Fixed point",
      "items": [
        "Refresh PR title begins ops: roadmap status refresh and touches only .harness/roadmap_status.md",
        "Its merge leaves the stored hash one commit behind; the next audit reads that as lag-expected, not drift",
        "Drill-downs: 01 audit, 02 build, 03 review, 04 merge + refresh"
      ]
    }
