  "cards": [
    {
      "dot": "cyan",
      "title": "Hooks that ride every build",
      "items": [
        "PreToolUse on Bash: precmd-clear-cache and rtk-shape-guard; on every tool: permission-guard (also on PermissionRequest)",
        "PostToolUse on Edit/Write: postedit-lint (ruff, yaml parse) and graft-mark-dirty; on Bash: post-merge-refresh advisory",
        "Stop: stop-gate blocks on ruff failure; git-arc-guard and stop-loop are advisory"
      ]
    },
    {
      "dot": "violet",
      "title": "Preflight before commit",
      "items": [
        "defect-class-preflight runs preflight-grep.sh then walks the ranked defect classes",
        "graft callers --depth 2 enumerates blast radius on any shared surface touch",
        "just codex-check is the superset local gate: sync, lint, fmt, typecheck, doc checks, parity, pytest"
      ]
    }
  ]
