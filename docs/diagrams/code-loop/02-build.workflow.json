      "from": "red",
      "to": "implement",
      "role": "return",
      "label": "fix",
      "variant": "dashed"
    },
    {
      "from": "codexcheck",
      "to": "commit",
      "role": "main",
      "label": "green",
      "variant": "emphasis"
    },
    {
      "from": "commit",
      "to": "stop",
      "role": "async",
      "label": "turn end",
      "variant": "dashed"
