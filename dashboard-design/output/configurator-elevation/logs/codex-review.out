    48	  required: ['verdicts'],
    49	}
    50	
    51	const candidateList = pool
    52	  .map(c => `- id=${c.id} | "${c.title}" | element=${c.element} | VIEW IMAGE: ${c.localImagePath}`)
    53	  .join('\n');
    54	
    55	phase('Evaluate');
    56	const evals = await parallel(SKILLS.map(skill => () =>
    57	  agent(
    58	    `You are a design specialist evaluating reference suitability through ONE lens only.\n\n` +
    59	    `Step 1: invoke the "${skill}" skill via the Skill tool (one call) and FULLY ADOPT its guidance. Judge ONLY through ${skill}'s principles.\n\n` +
    60	    `We are visually elevating this UI: ${UI}\n\n` +
    61	    `Below are candidate Dribbble references. For EACH candidate, use the Read tool to VIEW its image at the given local path, then decide: by ${skill}'s principles, does this reference genuinely inform the HIERARCHY / LAYOUT / DENSITY / TYPOGRAPHY / BRAND-IDENTITY elevation of THIS dark instrument-panel configurator? Ignore color (it stays fixed). Set suitable=true ONLY for a genuine, on-brand, instrument-precise fit; reject anything bright / playful / light / consumer / generic / off-brand. Be discerning - a strict lens is the point.\n\n` +
    62	    `Candidates:\n${candidateList}\n\n` +
    63	    `Return one verdict object per candidate id (suitable, a one-line reason, and a short "informs" naming the specific pattern it would teach).`,
    64	    { label: `eval:${skill}`, phase: 'Evaluate', schema: VERDICT_SCHEMA }
    65	  ).then(r => ({ skill, verdicts: (r && r.verdicts) || [] }))
    66	));
    67	
    68	phase('Converge');
    69	const bySkill = {};
    70	for (const e of evals.filter(Boolean)) {
    71	  bySkill[e.skill] = Object.fromEntries(e.verdicts.map(v => [v.id, v]));
    72	}
    73	const survivors = [];
    74	const matrix = [];
    75	for (const c of pool) {
    76	  const votes = SKILLS.map(s => (bySkill[s] || {})[c.id]);
    77	  const yes = votes.filter(v => v && v.suitable).length;
    78	  matrix.push({
    79	    id: c.id, title: c.title, url: c.url, element: c.element, agree: yes,
    80	    votes: SKILLS.map((s, i) => ({ skill: s, suitable: !!(votes[i] && votes[i].suitable), reason: (votes[i] && votes[i].reason) || '(no verdict)' })),
    81	  });
    82	  if (yes === SKILLS.length) {
    83	    survivors.push({
    84	      id: c.id, title: c.title, url: c.url, element: c.element,
    85	      informs: SKILLS.map((s, i) => `${s}: ${(votes[i] && (votes[i].informs || votes[i].reason)) || ''}`),
    86	    });
    87	  }
    88	}
    89	return { survivors, matrix, unanimousCount: survivors.length, poolSize: pool.length };

