    79	    '--output-format', 'stream-json',
    80	    '--verbose',
    81	    '--allowedTools', ALLOWED_TOOLS,
    82	  ];
    83	  if (MCP_CONFIG) { args.push('--mcp-config', MCP_CONFIG, '--strict-mcp-config'); }
    84	  const r = spawnSync('claude', args, {
    85	    cwd: CWD,
    86	    encoding: 'utf8',
    87	    timeout: TIMEOUT_MS,
    88	    maxBuffer: 64 * 1024 * 1024,
    89	    env: process.env,
    90	  });
    91	  const stdout = r.stdout || '';
    92	  try { fs.mkdirSync(LOGDIR, { recursive: true }); fs.writeFileSync(path.join(LOGDIR, `${tag}.jsonl`), stdout + (r.stderr ? '\n/*STDERR*/ ' + r.stderr : '')); } catch {}
    93	  if (r.error) throw new Error(`claude spawn failed: ${r.error.message} (partial stream saved to ${LOGDIR}/${tag}.jsonl)`);
    94	  if (r.status !== 0 && !stdout.trim()) throw new Error(`claude exited ${r.status}: ${(r.stderr || '').slice(0, 400)}`);
    95	  return stdout;
    96	}
    97	
    98	function parseStream(stdout) {
    99	  const lines = stdout.split('\n').map((l) => l.trim()).filter(Boolean);
   100	  const skillInvocations = [];
   101	  const dribbbleCalls = [];
   102	  let resultText = '';
   103	  for (const line of lines) {
   104	    let obj; try { obj = JSON.parse(line); } catch { continue; }
   105	    if (obj.type === 'assistant' && obj.message?.content) {
   106	      for (const block of obj.message.content) {
   107	        if (block.type === 'tool_use' && (block.name === 'Skill' || /skill/i.test(block.name))) {
   108	          const sk = block.input?.skill || block.input?.name || JSON.stringify(block.input);
   109	          skillInvocations.push(sk);
   110	        }
   111	        if (block.type === 'tool_use' && /dribbble/i.test(block.name || '')) {
   112	          dribbbleCalls.push(block.name);
   113	        }
   114	      }
   115	    }
   116	    if (obj.type === 'result' && typeof obj.result === 'string') resultText = obj.result;
   117	  }
   118	  return { skillInvocations, dribbbleCalls, resultText };
   119	}
   120	
   121	function extractVariantsJson(text) {
   122	  let s = String(text).trim();
   123	  const fence = s.match(/```(?:json)?\s*([\s\S]*?)```/i);
   124	  if (fence) s = fence[1].trim();
   125	  else { const i = s.indexOf('{'), j = s.lastIndexOf('}'); if (i >= 0 && j > i) s = s.slice(i, j + 1); }
   126	  return JSON.parse(s);
   127	}
   128	
   129	export default function createProducer() {
   130	  return {
   131	    async generateVariants(event, context = {}) {
   132	      const want = event.count || 3;
   133	      const tagId = event.id || String(Date.now());
   134	      const prompt = buildPrompt(event);
   135	
   136	      const stdout = runClaude(prompt, tagId);
   137	      const { skillInvocations, dribbbleCalls, resultText } = parseStream(stdout);
   138	
   139	      let parsed;
   140	      try { parsed = extractVariantsJson(resultText); }
   141	      catch (e) { throw new Error('skillchain: agent did not return parseable variants JSON: ' + e.message + ' :: ' + resultText.slice(0, 200)); }
   142	
   143	      let variants = Array.isArray(parsed.variants) ? parsed.variants : [];
   144	      if (variants.length === 0) throw new Error('skillchain: agent returned 0 variants');
   145	      while (variants.length < want) variants.push({ ...variants[variants.length - 1] });
   146	      variants = variants.slice(0, want);
   147	
   148	      const lintNotes = [];
   149	      variants = variants.map((v, i) => {
   150	        const { clean, fixes } = tasteLint(v.innerHtml || '');
   151	        if (fixes.length) lintNotes.push(`v${i + 1}:[${fixes.join(',')}]`);
   152	        return { innerHtml: clean };
   153	      });
   154	
   155	      const invoked = skillInvocations.length ? skillInvocations.join(', ') : '(none captured)';
   156	      const drib = dribbbleCalls.length ? dribbbleCalls.join(', ') : '(none)';
   157	      const refs = Array.isArray(parsed.references) ? parsed.references.join(', ') : '?';
   158	      process.stderr.write(
   159	        `  [skillchain] Skill tool_uses observed: [${invoked}]\n` +
   160	        `  [skillchain] Dribbble tool_uses observed: [${drib}]\n` +
   161	        `  [skillchain] references reported: [${refs}]\n` +
   162	        `  [skillchain] taste-lint gate: ${lintNotes.length ? lintNotes.join(' ') : 'clean'}  variants:${variants.length}  model:${MODEL}\n`
   163	      );
   164	
   165	      return { scopedCss: '', variants };
   166	    },
   167	  };
   168	}

