{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KfzEzVynd78u8SynahtSQ3","type":"tool_result","content":"1\t/* ===========================================================================\n2\t   ALMANAC NOIR — powerline statusline configurator\n3\t   Warm-dark operator console. Amber sole accent. Hairline rules. 2px radius.\n4\t   Display: Big Shoulders Display · Body: IBM Plex Sans · Mono: JetBrains Mono.\n5\t   CSS only — restyles app.js-emitted classes; renames nothing.\n6\t   =========================================================================== */\n7\t@import url('https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap');\n8\t\n9\t:root {\n10\t  --ground:#15120d;        /* warm near-black page bg */\n11\t  --panel:#1c1812;\n12\t  --panel-hi:#221d16;      /* elevated */\n13\t  --bone:#e8e0cf;          /* primary text — 14.2:1 on ground */\n14\t  --bone-soft:#cabfa2;     /* secondary — 9.1–10.2:1, AA-body everywhere */\n15\t  --bone-faint:#ab9f82;    /* labels / meta — 6.4–7.1:1, AA-body everywhere */\n16\t  --amber:#f0a830;         /* THE single signal accent — 8.2–9.2:1 */\n17\t  --amber-glow:#ffc14d;    /* amber, brighter — 10.3–11.5:1 */\n18\t  --ember:#d8542f;         /* alert / destructive ONLY — pair with a glyph, never color alone */\n19\t  --hair:#3a342a;          /* hairline rules */\n20\t  --hair-soft:#2a251e;\n21\t  --radius:2px;\n22\t  /* semantic z-index scale — sticky masthead < tooltip */\n23\t  --z-masthead:5;\n24\t  --z-tooltip:50;\n25\t  --disp:'Big Shoulders Display','Arial Narrow',sans-serif;\n26\t  --body:'IBM Plex Sans','Helvetica Neue',sans-serif;\n27\t  --mono:'JetBrains Mono','SFMono-Regular',ui-monospace,monospace;\n28\t}\n29\t\n30\t* { box-sizing: border-box; margin: 0; padding: 0; }\n31\thtml { font-size: 16px; }\n32\tbody {\n33\t  background: var(--ground);\n34\t  color: var(--bone);\n35\t  font-family: var(--body);\n36\t  line-height: 1.55;\n37\t  -webkit-font-smoothing: antialiased;\n38\t  font-variant-numeric: tabular-nums;\n39\t  /* faint engineering grid — the almanac substrate */\n40\t  background-image:\n41\t    linear-gradient(var(--hair-soft) 1px, transparent 1px),\n42\t    linear-gradient(90deg, var(--hair-soft) 1px, transparent 1px);\n43\t  background-size: 46px 46px;\n44\t  background-position: -1px -1px;\n45\t}\n46\t\n47\t/* ---------- masthead — the instrument header band ---------------------- */\n48\t.topbar {\n49\t  display: flex; align-items: center; justify-content: space-between;\n50\t  gap: 18px 24px; flex-wrap: wrap;\n51\t  padding: 16px clamp(20px, 4vw, 44px);\n52\t  background: linear-gradient(180deg, rgba(240,168,48,.05), transparent 80%), var(--panel);\n53\t  border-bottom: 1px solid var(--hair);\n54\t  position: sticky; top: 0; z-index: var(--z-masthead);\n55\t}\n56\t.brand {\n57\t  display: flex; align-items: baseline; gap: 11px;\n58\t  font-family: var(--disp); font-weight: 700; font-size: 27px;\n59\t  letter-spacing: .4px; line-height: .9; text-transform: uppercase;\n60\t  color: var(--bone);\n61\t}\n62\t.brand .mark {\n63\t  font-family: var(--mono); font-weight: 700; font-size: 15px;\n64\t  letter-spacing: 2.5px; color: var(--amber);\n65\t  padding: 3px 8px; border: 1px solid var(--hair); border-radius: var(--radius);\n66\t  background: var(--panel-hi); text-transform: none;\n67\t}\n68\t.brand .sig { color: var(--amber); }\n69\t.brand .sub {\n70\t  font-family: var(--mono); font-weight: 400; font-size: 11px;\n71\t  letter-spacing: 3px; color: var(--bone-faint); text-transform: uppercase;\n72\t  align-self: center;\n73\t}\n74\t\n75\t.actions { display: flex; align-items: center; gap: 14px; }\n76\t/* status — state carried by glyph + word, never color alone.\n77\t   app.js writes: \"unsaved changes\"(dirty) · \"saving…\" · \"saved ✓ …\"(saved)\n78\t   · \"error: …\"(err) · \"loading…\" · \"loaded\". Glyphs below are chosen to be\n79\t   distinct from each text (no doubled ✓ on saved). */\n80\t.status {\n81\t  display: inline-flex; align-items: baseline; gap: 7px;\n82\t  font-family: var(--mono); font-size: 12px; letter-spacing: 1px;\n83\t  text-transform: uppercase; color: var(--bone-faint);\n84\t  min-width: 210px; justify-content: flex-end; text-align: right;\n85\t}\n86\t.status::before {\n87\t  font-weight: 700; font-size: 12px; line-height: 1;\n88\t  flex: 0 0 auto; transform: translateY(.5px);\n89\t}\n90\t.status.dirty { color: var(--amber-glow); }\n91\t.status.dirty::before { content: \"●\"; }       /* pending — filled dot (text: \"unsaved changes\") */\n92\t.status.saved { color: var(--amber); }\n93\t.status.saved::before { content: \"▸\"; }       /* committed — text already carries its own ✓; lead with a distinct mark, no doubled check */\n94\t/* err — ember on panel is 4.40 (sub-AA at 12px); a recessed ground chip lifts\n95\t   the effective ratio to 4.65 (ground) ≥ AA-body. The ✕ glyph rides inside it. */\n96\t.status.err {\n97\t  color: var(--ember); font-weight: 600;\n98\t  background: var(--ground); border: 1px solid var(--hair);\n99\t  border-radius: var(--radius); padding: 3px 8px;\n100\t}\n101\t.status.err::before { content: \"✕\"; color: var(--ember); }  /* fault — distinct shape + the word \"error:\" */\n102\t\n103\t/* ---------- buttons ---------------------------------------------------- */\n104\t.btn {\n105\t  font-family: var(--mono); font-size: 12.5px; font-weight: 500;\n106\t  letter-spacing: 1px; text-transform: uppercase;\n107\t  border: 1px solid var(--hair); background: var(--panel-hi); color: var(--bone-soft);\n108\t  padding: 9px 16px; border-radius: var(--radius); cursor: pointer;\n109\t  transition: border-color .15s ease, color .15s ease, background .15s ease, transform .08s ease;\n110\t}\n111\t.btn:hover { border-color: var(--amber); color: var(--bone); }\n112\t.btn:active { transform: translateY(1px); }   /* tactile press */\n113\t.btn.primary {\n114\t  background: var(--amber); border-color: var(--amber-glow); color: var(--ground);\n115\t  font-weight: 700;\n116\t}\n117\t.btn.primary:hover { background: var(--amber-glow); color: var(--ground); }\n118\t.btn.ghost { background: transparent; }\n119\t.btn.ghost:hover { background: rgba(240,168,48,.07); }\n120\t.btn.mini {\n121\t  padding: 5px 9px; font-size: 12px; letter-spacing: .5px;\n122\t  min-width: 32px; min-height: 28px; text-align: center; line-height: 1;\n123\t}\n124\t.btn.danger { border-color: var(--hair); color: var(--bone-faint); }\n125\t.btn.danger:hover { border-color: var(--ember); color: var(--amber-glow); background: rgba(216,84,47,.14); }\n126\t\n127\t/* ---------- layout ----------------------------------------------------- */\n128\t.wrap { max-width: 1060px; margin: 0 auto; padding: 36px clamp(20px, 4vw, 44px) 80px; }\n129\t\n130\t/* ---------- framed terminal preview (signature element) ---------------- */\n131\t.termwin {\n132\t  background: var(--panel); border: 1px solid var(--hair); border-radius: var(--radius);\n133\t  overflow: hidden; margin-bottom: 44px;\n134\t  box-shadow: inset 0 0 0 1px rgba(240,168,48,.06), inset 0 1px 26px rgba(240,168,48,.04);\n135\t}\n136\t.termbar {\n137\t  display: flex; align-items: center; gap: 16px;\n138\t  padding: 11px 16px; background: var(--panel-hi);\n139\t  border-bottom: 1px solid var(--hair);\n140\t}\n141\t.dots { display: flex; gap: 7px; }\n142\t.dots i {\n143\t  width: 9px; height: 9px; border-radius: 50%;\n144\t  background: transparent; border: 1px solid var(--hair);\n145\t}\n146\t.dots i:nth-child(3) { background: var(--amber); border-color: var(--amber-glow); }\n147\t.termtitle {\n148\t  flex: 1; text-align: center;\n149\t  font-family: var(--mono); font-size: 11.5px; letter-spacing: 2px;\n150\t  text-transform: uppercase; color: var(--bone-faint);\n151\t}\n152\t.width { display: flex; align-items: center; gap: 11px; }\n153\t.width input[type=range] {\n154\t  width: 150px; accent-color: var(--amber); cursor: pointer;\n155\t  background: transparent;\n156\t}\n157\t.width input[type=range]:focus-visible {\n158\t  outline: 2px solid var(--amber-glow); outline-offset: 4px; border-radius: var(--radius);\n159\t}\n160\t.cols-badge {\n161\t  font-family: var(--mono); font-size: 11px; font-weight: 700; letter-spacing: 1px;\n162\t  color: var(--amber); background: var(--panel); border: 1px solid var(--hair);\n163\t  padding: 3px 9px; border-radius: var(--radius); white-space: nowrap;\n164\t  text-transform: uppercase;\n165\t}\n166\t.preview {\n167\t  font-family: \"MesloLGS NF\", \"JetBrainsMono Nerd Font\", \"Hack Nerd Font\",\n168\t    \"Symbols Nerd Font\", ui-monospace, Menlo, monospace;\n169\t  font-size: 17px; line-height: 1.85; white-space: pre; overflow-x: auto;\n170\t  padding: 20px 18px; min-height: 36px; background: var(--ground);\n171\t  color: var(--bone);\n172\t}\n173\t.preview-err {\n174\t  color: var(--ember); font-size: 12px; padding: 0 18px; white-space: pre-wrap;\n175\t  font-family: var(--mono); background: var(--ground);\n176\t}\n177\t.approx {\n178\t  font-family: var(--mono); font-size: 11px; letter-spacing: .5px;\n179\t  color: var(--bone-faint); padding: 10px 18px 14px; background: var(--ground);\n180\t  border-top: 1px solid var(--hair-soft);\n181\t}\n182\t\n183\t/* ---------- numbered sections — quiet, integrated header rhythm.\n184\t   The 01/02/03 markers are a real ordered sequence (Theme → Segments →\n185\t   Custom), not decorative scaffolding — they earn their place. -------- */\n186\t.step { margin-bottom: 46px; }\n187\t.step-head { display: flex; align-items: baseline; gap: 14px; margin-bottom: 18px; }\n188\t.step-head .num {\n189\t  flex: 0 0 auto;\n190\t  font-family: var(--mono); font-size: 14px; font-weight: 700; letter-spacing: 1px;\n191\t  color: var(--amber);\n192\t}\n193\t.step-head .num::before { content: \"0\"; }\n194\t.step-head > div { flex: 1; min-width: 0; }\n195\t.step-head h2 {\n196\t  font-family: var(--disp); font-weight: 600; font-size: 25px;\n197\t  letter-spacing: .5px; text-transform: uppercase; color: var(--bone);\n198\t  line-height: 1;\n199\t}\n200\t.step-head p {\n201\t  font-size: 13.5px; color: var(--bone-soft); margin-top: 8px; line-height: 1.55;\n202\t  max-width: 68ch;\n203\t}\n204\t.step-body {\n205\t  background: var(--panel); border: 1px solid var(--hair); border-radius: var(--radius);\n206\t  padding: 4px 22px;\n207\t}\n208\t\n209\t/* ---------- theme / display + custom rows (.field) --------------------- */\n210\t.field {\n211\t  display: flex; align-items: center; justify-content: space-between; gap: 18px;\n212\t  padding: 15px 0; border-bottom: 1px solid var(--hair-soft);\n213\t}\n214\t.field:last-child { border-bottom: 0; }\n215\t.field > label {\n216\t  color: var(--bone); font-size: 14.5px; font-weight: 500; line-height: 1.4;\n217\t  cursor: default;\n218\t}\n219\t/* .ctl = flex container so select / input / switch all right-align cleanly */\n220\t.field .ctl {\n221\t  display: flex; align-items: center; justify-content: flex-end; flex-shrink: 0;\n222\t}\n223\t.field .ctl select,\n224\t.field .ctl input {\n225\t  font-family: var(--mono); font-size: 13px;\n226\t  background: var(--panel-hi); color: var(--bone); border: 1px solid var(--hair);\n227\t  border-radius: var(--radius); padding: 8px 11px;\n228\t  transition: border-color .15s ease;\n229\t}\n230\t.field .ctl select:hover,\n231\t.field .ctl input:hover { border-color: var(--bone-faint); }\n232\t/* amber border on any focus; suppress the UA outline only for non-keyboard\n233\t   focus, so the keyboard ring below still fires (color alone never carries\n234\t   focus). */\n235\t.field .ctl select:focus,\n236\t.field .ctl input:focus { border-color: var(--amber); }\n237\t.field .ctl select:focus:not(:focus-visible),\n238\t.field .ctl input:focus:not(:focus-visible) { outline: none; }\n239\t.field .ctl select:focus-visible,\n240\t.field .ctl input:focus-visible {\n241\t  border-color: var(--amber); outline: 2px solid var(--amber-glow);\n242\t  outline-offset: 2px;\n243\t}\n244\t.field .ctl input[type=number] { width: 120px; }\n245\t\n246\t/* ---------- lines + segments ------------------------------------------- */\n247\t.lineblock {\n248\t  border: 1px solid var(--hair); border-radius: var(--radius);\n249\t  padding: 16px; margin: 16px 0; background: var(--panel-hi);\n250\t}\n251\t.lineblock > .lhead {\n252\t  display: flex; align-items: center; justify-content: space-between;\n253\t  margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--hair-soft);\n254\t}\n255\t.lhead .ltitle {\n256\t  font-family: var(--mono); font-weight: 700; font-size: 12px;\n257\t  letter-spacing: 2px; text-transform: uppercase; color: var(--amber);\n258\t}\n259\t\n260\t/* segment — on/off carried by the toggle knob position (primary, non-color),\n261\t   opacity (secondary), and the icon: amber when on, faint when off. The amber\n262\t   accent stays scarce (icon + focus), not a perimeter stripe on every row. */\n263\t.seg {\n264\t  border: 1px solid var(--hair);\n265\t  border-radius: var(--radius); padding: 13px 15px; margin-bottom: 10px;\n266\t  background: var(--panel);\n267\t  transition: border-color .16s ease, opacity .16s ease, background .16s ease;\n268\t}\n269\t.seg:not(.off):hover { border-color: var(--bone-faint); }\n270\t.seg.off { opacity: .55; background: var(--ground); }\n271\t.seg.off .seg-icon { color: var(--bone-faint); }\n272\t.seg .seg-row { display: flex; align-items: center; gap: 13px; }\n273\t.seg .seg-icon {\n274\t  color: var(--amber); font-size: 16px; min-width: 18px; text-align: center;\n275\t  font-family: var(--mono); transition: color .16s ease;\n276\t}\n277\t.seg .seg-name {\n278\t  font-family: var(--disp); font-weight: 600; font-size: 18px; letter-spacing: .4px;\n279\t  text-transform: uppercase; color: var(--bone); cursor: help;\n280\t  border-bottom: 1px dotted var(--bone-soft);\n281\t  transition: border-color .15s ease;\n282\t}\n283\t.seg .seg-name:hover { border-bottom-color: var(--amber); }\n284\t.seg .grow { flex: 1; }\n285\t\n286\t.seg .opts {\n287\t  margin-top: 14px; padding-top: 13px; border-top: 1px solid var(--hair-soft);\n288\t  display: flex; flex-wrap: wrap; gap: 12px 22px;\n289\t}\n290\t/* .opt has two child orders (bool: [switch,label] · enum/num/text: [label,control]) —\n291\t   flex with row-align keeps both readable. */\n292\t.opt {\n293\t  display: flex; align-items: center; gap: 9px;\n294\t  font-family: var(--mono); font-size: 12.5px; color: var(--bone-soft);\n295\t  letter-spacing: .3px;\n296\t}\n297\t.opt select,\n298\t.opt input[type=text],\n299\t.opt input[type=number] {\n300\t  font-family: var(--mono); font-size: 12.5px;\n301\t  background: var(--panel-hi); color: var(--bone); border: 1px solid var(--hair);\n302\t  border-radius: var(--radius); padding: 6px 9px;\n303\t  transition: border-color .15s ease;\n304\t}\n305\t.opt select:hover,\n306\t.opt input:hover { border-color: var(--bone-faint); }\n307\t.opt select:focus,\n308\t.opt input:focus { border-color: var(--amber); }\n309\t.opt select:focus:not(:focus-visible),\n310\t.opt input:focus:not(:focus-visible) { outline: none; }\n311\t.opt select:focus-visible,\n312\t.opt input:focus-visible {\n313\t  border-color: var(--amber); outline: 2px solid var(--amber-glow); outline-offset: 2px;\n314\t}\n315\t.opt input[type=text] { width: 150px; }\n316\t.opt input[type=number] { width: 100px; }\n317\t\n318\t/* folded budget / context-limits sub-block inside a segment */\n319\t.fold {\n320\t  margin-top: 14px; border: 1px dashed var(--hair); border-radius: var(--radius);\n321\t  padding: 12px 14px; background: var(--ground);\n322\t}\n323\t.fold .fold-title {\n324\t  font-family: var(--mono); font-size: 11px; font-weight: 700;\n325\t  letter-spacing: 1.5px; text-transform: uppercase; color: var(--amber);\n326\t  margin-bottom: 10px;\n327\t}\n328\t.fold .opts { margin-top: 0; padding-top: 0; border-top: 0; }\n329\t\n330\t.addrow { display: flex; gap: 10px; margin: 14px 0 4px; }\n331\t.addrow select {\n332\t  flex: 1; font-family: var(--mono); font-size: 13px;\n333\t  background: var(--panel); color: var(--bone-soft); border: 1px dashed var(--hair);\n334\t  border-radius: var(--radius); padding: 10px 11px; cursor: pointer;\n335\t  transition: border-color .15s ease, color .15s ease;\n336\t}\n337\t.addrow select:hover { border-color: var(--amber); color: var(--bone); }\n338\t.addrow select:focus { border-color: var(--amber); }\n339\t.addrow select:focus:not(:focus-visible) { outline: none; }\n340\t.addrow select:focus-visible {\n341\t  border-color: var(--amber); outline: 2px solid var(--amber-glow); outline-offset: 2px;\n342\t}\n343\t\n344\t/* ---------- the toggle switch — works in EVERY parent (bug #1 fix) ------ */\n345\t/* inline-block so width/height apply outside flex parents (theme/custom rows) */\n346\t.switch {\n347\t  display: inline-block; position: relative;\n348\t  width: 42px; height: 22px; flex: 0 0 auto; vertical-align: middle; cursor: pointer;\n349\t}\n350\t.switch input { position: absolute; opacity: 0; width: 0; height: 0; }\n351\t/* OFF: visibly a track (recessed panel-hi well + hairline) with the knob parked\n352\t   left. ON: amber track, knob parked right. Knob POSITION is the non-color cue. */\n353\t.switch .slider {\n354\t  position: absolute; inset: 0;\n355\t  background: var(--panel-hi); border: 1px solid var(--hair);\n356\t  border-radius: 22px; transition: background .15s ease, border-color .15s ease;\n357\t  cursor: pointer;\n358\t}\n359\t.switch:hover .slider { border-color: var(--bone-faint); }\n360\t.switch .slider::before {\n361\t  content: \"\"; position: absolute;\n362\t  width: 16px; height: 16px; left: 2px; top: 2px;\n363\t  background: var(--bone-faint); border-radius: 50%;\n364\t  transition: transform .15s ease, background .15s ease;\n365\t}\n366\t.switch input:checked + .slider {\n367\t  background: var(--amber); border-color: var(--amber-glow);\n368\t}\n369\t.switch:hover input:checked + .slider { border-color: var(--amber-glow); }\n370\t.switch input:checked + .slider::before {\n371\t  transform: translateX(20px); background: var(--ground);\n372\t}\n373\t.switch input:focus-visible + .slider { outline: 2px solid var(--amber-glow); outline-offset: 3px; }\n374\t\n375\t/* ---------- tooltip ---------------------------------------------------- */\n376\t.tooltip {\n377\t  position: fixed; max-width: 300px;\n378\t  background: var(--panel-hi); color: var(--bone-soft);\n379\t  border: 1px solid var(--hair);\n380\t  border-radius: var(--radius); padding: 11px 14px;\n381\t  font-size: 13px; line-height: 1.55; z-index: var(--z-tooltip); pointer-events: none;\n382\t  /* a floating popover earns a lift; tightened blur + amber inset edge keeps it\n383\t     in the inset-glow family rather than a soft generic drop shadow. */\n384\t  box-shadow: inset 0 0 0 1px rgba(240,168,48,.10), 0 6px 18px rgba(0,0,0,.45);\n385\t}\n386\t.tooltip .tt-title {\n387\t  font-family: var(--disp); font-weight: 700; font-size: 15px; letter-spacing: .4px;\n388\t  text-transform: uppercase; color: var(--amber); margin-bottom: 5px;\n389\t}\n390\t\n391\t/* ---------- accessibility floor ----------------------------------------\n392\t   Base keyboard ring for every interactive element. High-traffic controls\n393\t   (selects/inputs/toggle/slider) layer amber-glow rings above this. */\n394\t:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; border-radius: var(--radius); }\n395\t/* Kill ALL motion — transitions AND any animation — when the user asks. */\n396\t@media (prefers-reduced-motion: reduce) {\n397\t  *, *::before, *::after {\n398\t    transition: none !important;\n399\t    animation: none !important;\n400\t    scroll-behavior: auto !important;\n401\t  }\n402\t}\n403\t\n404\t/* ---------- responsive ------------------------------------------------- */\n405\t@media (max-width: 640px) {\n406\t  .topbar { flex-direction: column; align-items: flex-start; }\n407\t  .actions { width: 100%; justify-content: flex-end; }\n408\t  .status { min-width: 0; flex: 1; justify-content: flex-start; text-align: left; }\n409\t  .field { flex-direction: column; align-items: stretch; gap: 8px; }\n410\t  .field .ctl { justify-content: flex-start; }\n411\t  .seg .opts { gap: 12px 18px; }\n412\t  .width input[type=range] { width: 110px; }\n413\t}\n414\t"}]},"parent_tool_use_id":null,"session_id":"dd62c9ec-8b5a-4276-bac0-d2c82122134c","uuid":"ed271ac3-7fd4-4977-865b-f62464b5589f","timestamp":"2026-06-17T18:19:05.759Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/robertrhu/.claude/powerline-config/static/style.css","content":"/* ===========================================================================\n   ALMANAC NOIR — powerline statusline configurator\n   Warm-dark operator console. Amber sole accent. Hairline rules. 2px radius.\n   Display: Big Shoulders Display · Body: IBM Plex Sans · Mono: JetBrains Mono.\n   CSS only — restyles app.js-emitted classes; renames nothing.\n   =========================================================================== */\n@import url('https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap');\n\n:root {\n  --ground:#15120d;        /* warm near-black page bg */\n  --panel:#1c1812;\n  --panel-hi:#221d16;      /* elevated */\n  --bone:#e8e0cf;          /* primary text — 14.2:1 on ground */\n  --bone-soft:#cabfa2;     /* secondary — 9.1–10.2:1, AA-body everywhere */\n  --bone-faint:#ab9f82;    /* labels / meta — 6.4–7.1:1, AA-body everywhere */\n  --amber:#f0a830;         /* THE single signal accent — 8.2–9.2:1 */\n  --amber-glow:#ffc14d;    /* amber, brighter — 10.3–11.5:1 */\n  --ember:#d8542f;         /* alert / destructive ONLY — pair with a glyph, never color alone */\n  --hair:#3a342a;          /* hairline rules */\n  --hair-soft:#2a251e;\n  --radius:2px;\n  /* semantic z-index scale — sticky masthead < tooltip */\n  --z-masthead:5;\n  --z-tooltip:50;\n  --disp:'Big Shoulders Display','Arial Narrow',sans-serif;\n  --body:'IBM Plex Sans','Helvetica Neue',sans-serif;\n  --mono:'JetBrains Mono','SFMono-Regular',ui-monospace,monospace;\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\nhtml { font-size: 16px; }\nbody {\n  background: var(--ground);\n  color: var(--bone);\n  font-family: var(--body);\n  line-height: 1.55;\n  -webkit-font-smoothing: antialiased;\n  font-variant-numeric: tabular-nums;\n  /* faint engineering grid — the almanac substrate */\n  background-image:\n    linear-gradient(var(--hair-soft) 1px, transparent 1px),\n    linear-gradient(90deg, var(--hair-soft) 1px, transparent 1px);\n  background-size: 46px 46px;\n  background-position: -1px -1px;\n}\n\n/* ---------- masthead — the instrument header band ---------------------- */\n.topbar {\n  display: flex; align-items: center; justify-content: space-between;\n  gap: 18px 24px; flex-wrap: wrap;\n  padding: 16px clamp(20px, 4vw, 44px);\n  background: linear-gradient(180deg, rgba(240,168,48,.05), transparent 80%), var(--panel);\n  border-bottom: 1px solid var(--hair);\n  position: sticky; top: 0; z-index: var(--z-masthead);\n}\n.brand {\n  display: flex; align-items: baseline; gap: 11px;\n  font-family: var(--disp); font-weight: 700; font-size: 27px;\n  letter-spacing: .4px; line-height: .9; text-transform: uppercase;\n  color: var(--bone);\n}\n.brand .mark {\n  font-family: var(--mono); font-weight: 700; font-size: 15px;\n  letter-spacing: 2.5px; color: var(--amber);\n  padding: 3px 8px; border: 1px solid var(--hair); border-radius: var(--radius);\n  background: var(--panel-hi); text-transform: none;\n}\n.brand .sig { color: var(--amber); }\n.brand .sub {\n  font-family: var(--mono); font-weight: 400; font-size: 11px;\n  letter-spacing: 3px; color: var(--bone-faint); text-transform: uppercase;\n  align-self: center;\n}\n\n.actions { display: flex; align-items: center; gap: 14px; }\n/* status — state carried by glyph + word, never color alone.\n   app.js writes: \"unsaved changes\"(dirty) · \"saving…\" · \"saved ✓ …\"(saved)\n   · \"error: …\"(err) · \"loading…\" · \"loaded\". Glyphs below are chosen to be\n   distinct from each text (no doubled ✓ on saved). */\n.status {\n  display: inline-flex; align-items: baseline; gap: 7px;\n  font-family: var(--mono); font-size: 12px; letter-spacing: 1px;\n  text-transform: uppercase; color: var(--bone-faint);\n  min-width: 210px; justify-content: flex-end; text-align: right;\n}\n.status::before {\n  font-weight: 700; font-size: 12px; line-height: 1;\n  flex: 0 0 auto; transform: translateY(.5px);\n}\n.status.dirty { color: var(--amber-glow); }\n.status.dirty::before { content: \"●\"; }       /* pending — filled dot (text: \"unsaved changes\") */\n.status.saved { color: var(--amber); }\n.status.saved::before { content: \"▸\"; }       /* committed — text already carries its own ✓; lead with a distinct mark, no doubled check */\n/* err — ember on panel is 4.40 (sub-AA at 12px); a recessed ground chip lifts\n   the effective ratio to 4.65 (ground) ≥ AA-body. The ✕ glyph rides inside it. */\n.status.err {\n  color: var(--ember); font-weight: 600;\n  background: var(--ground); border: 1px solid var(--hair);\n  border-radius: var(--radius); padding: 3px 8px;\n}\n.status.err::before { content: \"✕\"; color: var(--ember); }  /* fault — distinct shape + the word \"error:\" */\n\n/* ---------- buttons ---------------------------------------------------- */\n.btn {\n  font-family: var(--mono); font-size: 12.5px; font-weight: 500;\n  letter-spacing: 1px; text-transform: uppercase;\n  border: 1px solid var(--hair); background: var(--panel-hi); color: var(--bone-soft);\n  padding: 9px 16px; border-radius: var(--radius); cursor: pointer;\n  transition: border-color .15s ease, color .15s ease, background .15s ease, transform .08s ease;\n}\n.btn:hover { border-color: var(--amber); color: var(--bone); }\n.btn:active { transform: translateY(1px); }   /* tactile press */\n.btn.primary {\n  background: var(--amber); border-color: var(--amber-glow); color: var(--ground);\n  font-weight: 700;\n}\n.btn.primary:hover { background: var(--amber-glow); color: var(--ground); }\n.btn.ghost { background: transparent; }\n.btn.ghost:hover { background: rgba(240,168,48,.07); }\n.btn.mini {\n  padding: 5px 9px; font-size: 12px; letter-spacing: .5px;\n  min-width: 32px; min-height: 28px; text-align: center; line-height: 1;\n}\n.btn.danger { border-color: var(--hair); color: var(--bone-faint); }\n.btn.danger:hover { border-color: var(--ember); color: var(--amber-glow); background: rgba(216,84,47,.14); }\n\n/* ---------- layout ----------------------------------------------------- */\n.wrap { max-width: 1060px; margin: 0 auto; padding: 36px clamp(20px, 4vw, 44px) 80px; }\n\n/* ---------- framed terminal preview (signature element) ---------------- */\n.termwin {\n  background: var(--panel); border: 1px solid var(--hair); border-radius: var(--radius);\n  overflow: hidden; margin-bottom: 44px;\n  box-shadow: inset 0 0 0 1px rgba(240,168,48,.06), inset 0 1px 26px rgba(240,168,48,.04);\n}\n.termbar {\n  display: flex; align-items: center; gap: 16px;\n  padding: 11px 16px; background: var(--panel-hi);\n  border-bottom: 1px solid var(--hair);\n}\n.dots { display: flex; gap: 7px; }\n.dots i {\n  width: 9px; height: 9px; border-radius: 50%;\n  background: transparent; border: 1px solid var(--hair);\n}\n.dots i:nth-child(3) { background: var(--amber); border-color: var(--amber-glow); }\n.termtitle {\n  flex: 1; text-align: center;\n  font-family: var(--mono); font-size: 11.5px; letter-spacing: 2px;\n  text-transform: uppercase; color: var(--bone-faint);\n}\n.width { display: flex; align-items: center; gap: 11px; }\n.width input[type=range] {\n  width: 150px; accent-color: var(--amber); cursor: pointer;\n  background: transparent;\n}\n.width input[type=range]:focus-visible {\n  outline: 2px solid var(--amber-glow); outline-offset: 4px; border-radius: var(--radius);\n}\n.cols-badge {\n  font-family: var(--mono); font-size: 11px; font-weight: 700; letter-spacing: 1px;\n  color: var(--amber); background: var(--panel); border: 1px solid var(--hair);\n  padding: 3px 9px; border-radius: var(--radius); white-space: nowrap;\n  text-transform: uppercase;\n}\n.preview {\n  font-family: \"MesloLGS NF\", \"JetBrainsMono Nerd Font\", \"Hack Nerd Font\",\n    \"Symbols Nerd Font\", ui-monospace, Menlo, monospace;\n  font-size: 17px; line-height: 1.85; white-space: pre; overflow-x: auto;\n  padding: 20px 18px; min-height: 36px; background: var(--ground);\n  color: var(--bone);\n}\n.preview-err {\n  color: var(--ember); font-size: 12px; padding: 0 18px; white-space: pre-wrap;\n  font-family: var(--mono); background: var(--ground);\n}\n.approx {\n  font-family: var(--mono); font-size: 11px; letter-spacing: .5px;\n  color: var(--bone-faint); padding: 10px 18px 14px; background: var(--ground);\n  border-top: 1px solid var(--hair-soft);\n}\n\n/* ---------- numbered sections — quiet, integrated header rhythm.\n   The 01/02/03 markers are a real ordered sequence (Theme → Segments →\n   Custom), not decorative scaffolding — they earn their place. -------- */\n.step { margin-bottom: 46px; }\n.step-head { display: flex; align-items: baseline; gap: 14px; margin-bottom: 18px; }\n.step-head .num {\n  flex: 0 0 auto;\n  font-family: var(--mono); font-size: 14px; font-weight: 700; letter-spacing: 1px;\n  color: var(--amber);\n}\n.step-head .num::before { content: \"0\"; }\n.step-head > div { flex: 1; min-width: 0; }\n.step-head h2 {\n  font-family: var(--disp); font-weight: 600; font-size: 25px;\n  letter-spacing: .5px; text-transform: uppercase; color: var(--bone);\n  line-height: 1;\n}\n.step-head p {\n  font-size: 13.5px; color: var(--bone-soft); margin-top: 8px; line-height: 1.55;\n  max-width: 68ch;\n}\n.step-body {\n  background: var(--panel); border: 1px solid var(--hair); border-radius: var(--radius);\n  padding: 4px 22px;\n}\n\n/* ---------- theme / display + custom rows (.field) --------------------- */\n.field {\n  display: flex; align-items: center; justify-content: space-between; gap: 18px;\n  padding: 15px 0; border-bottom: 1px solid var(--hair-soft);\n}\n.field:last-child { border-bottom: 0; }\n.field > label {\n  color: var(--bone); font-size: 14.5px; font-weight: 500; line-height: 1.4;\n  cursor: default;\n}\n/* .ctl = flex container so select / input / switch all right-align cleanly */\n.field .ctl {\n  display: flex; align-items: center; justify-content: flex-end; flex-shrink: 0;\n}\n.field .ctl select,\n.field .ctl input {\n  font-family: var(--mono); font-size: 13px;\n  background: var(--panel-hi); color: var(--bone); border: 1px solid var(--hair);\n  border-radius: var(--radius); padding: 8px 11px;\n  transition: border-color .15s ease;\n}\n.field .ctl select:hover,\n.field .ctl input:hover { border-color: var(--bone-faint); }\n/* amber border on any focus; suppress the UA outline only for non-keyboard\n   focus, so the keyboard ring below still fires (color alone never carries\n   focus). */\n.field .ctl select:focus,\n.field .ctl input:focus { border-color: var(--amber); }\n.field .ctl select:focus:not(:focus-visible),\n.field .ctl input:focus:not(:focus-visible) { outline: none; }\n.field .ctl select:focus-visible,\n.field .ctl input:focus-visible {\n  border-color: var(--amber); outline: 2px solid var(--amber-glow);\n  outline-offset: 2px;\n}\n.field .ctl input[type=number] { width: 120px; }\n\n/* ---------- lines + segments ------------------------------------------- */\n.lineblock {\n  border: 1px solid var(--hair); border-radius: var(--radius);\n  padding: 16px; margin: 16px 0; background: var(--panel-hi);\n}\n.lineblock > .lhead {\n  display: flex; align-items: center; justify-content: space-between;\n  margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--hair-soft);\n}\n.lhead .ltitle {\n  font-family: var(--mono); font-weight: 700; font-size: 12px;\n  letter-spacing: 2px; text-transform: uppercase; color: var(--amber);\n}\n\n/* segment — on/off carried by the toggle knob position (primary, non-color),\n   opacity (secondary), and the icon: amber when on, faint when off. The amber\n   accent stays scarce (icon + focus), not a perimeter stripe on every row. */\n.seg {\n  border: 1px solid var(--hair);\n  border-radius: var(--radius); padding: 13px 15px; margin-bottom: 10px;\n  background: var(--panel);\n  transition: border-color .16s ease, opacity .16s ease, background .16s ease;\n}\n.seg:not(.off):hover { border-color: var(--bone-faint); }\n.seg.off { opacity: .55; background: var(--ground); }\n.seg.off .seg-icon { color: var(--bone-faint); }\n.seg .seg-row { display: flex; align-items: center; gap: 13px; }\n.seg .seg-icon {\n  color: var(--amber); font-size: 16px; min-width: 18px; text-align: center;\n  font-family: var(--mono); transition: color .16s ease;\n}\n.seg .seg-name {\n  font-family: var(--disp); font-weight: 600; font-size: 18px; letter-spacing: .4px;\n  text-transform: uppercase; color: var(--bone); cursor: help;\n  border-bottom: 1px dotted var(--bone-soft);\n  transition: border-color .15s ease;\n}\n.seg .seg-name:hover { border-bottom-color: var(--amber); }\n.seg .grow { flex: 1; }\n\n.seg .opts {\n  margin-top: 14px; padding-top: 13px; border-top: 1px solid var(--hair-soft);\n  display: flex; flex-wrap: wrap; gap: 12px 22px;\n}\n/* .opt has two child orders (bool: [switch,label] · enum/num/text: [label,control]) —\n   flex with row-align keeps both readable. */\n.opt {\n  display: flex; align-items: center; gap: 9px;\n  font-family: var(--mono); font-size: 12.5px; color: var(--bone-soft);\n  letter-spacing: .3px;\n}\n.opt select,\n.opt input[type=text],\n.opt input[type=number] {\n  font-family: var(--mono); font-size: 12.5px;\n  background: var(--panel-hi); color: var(--bone); border: 1px solid var(--hair);\n  border-radius: var(--radius); padding: 6px 9px;\n  transition: border-color .15s ease;\n}\n.opt select:hover,\n.opt input:hover { border-color: var(--bone-faint); }\n.opt select:focus,\n.opt input:focus { border-color: var(--amber); }\n.opt select:focus:not(:focus-visible),\n.opt input:focus:not(:focus-visible) { outline: none; }\n.opt select:focus-visible,\n.opt input:focus-visible {\n  border-color: var(--amber); outline: 2px solid var(--amber-glow); outline-offset: 2px;\n}\n.opt input[type=text] { width: 150px; }\n.opt input[type=number] { width: 100px; }\n\n/* folded budget / context-limits sub-block inside a segment */\n.fold {\n  margin-top: 14px; border: 1px dashed var(--hair); border-radius: var(--radius);\n  padding: 12px 14px; background: var(--ground);\n}\n.fold .fold-title {\n  font-family: var(--mono); font-size: 11px; font-weight: 700;\n  letter-spacing: 1.5px; text-transform: uppercase; color: var(--amber);\n  margin-bottom: 10px;\n}\n.fold .opts { margin-top: 0; padding-top: 0; border-top: 0; }\n\n.addrow { display: flex; gap: 10px; margin: 14px 0 4px; }\n.addrow select {\n  flex: 1; font-family: var(--mono); font-size: 13px;\n  background: var(--panel); color: var(--bone-soft); border: 1px dashed var(--hair);\n  border-radius: var(--radius); padding: 10px 11px; cursor: pointer;\n  transition: border-color .15s ease, color .15s ease;\n}\n.addrow select:hover { border-color: var(--amber); color: var(--bone); }\n.addrow select:focus { border-color: var(--amber); }\n.addrow select:focus:not(:focus-visible) { outline: none; }\n.addrow select:focus-visible {\n  border-color: var(--amber); outline: 2px solid var(--amber-glow); outline-offset: 2px;\n}\n\n/* ---------- the toggle switch — works in EVERY parent (bug #1 fix) ------ */\n/* inline-block so width/height apply outside flex parents (theme/custom rows) */\n.switch {\n  display: inline-block; position: relative;\n  width: 42px; height: 22px; flex: 0 0 auto; vertical-align: middle; cursor: pointer;\n}\n.switch input { position: absolute; opacity: 0; width: 0; height: 0; }\n/* OFF: visibly a track (recessed panel-hi well + hairline) with the knob parked\n   left. ON: amber track, knob parked right. Knob POSITION is the non-color cue. */\n.switch .slider {\n  position: absolute; inset: 0;\n  background: var(--panel-hi); border: 1px solid var(--hair);\n  border-radius: 22px; transition: background .15s ease, border-color .15s ease;\n  cursor: pointer;\n}\n.switch:hover .slider { border-color: var(--bone-faint); }\n.switch .slider::before {\n  content: \"\"; position: absolute;\n  width: 16px; height: 16px; left: 2px; top: 2px;\n  background: var(--bone-faint); border-radius: 50%;\n  transition: transform .15s ease, background .15s ease;\n}\n.switch input:checked + .slider {\n  background: var(--amber); border-color: var(--amber-glow);\n}\n.switch:hover input:checked + .slider { border-color: var(--amber-glow); }\n.switch input:checked + .slider::before {\n  transform: translateX(20px); background: var(--ground);\n}\n.switch input:focus-visible + .slider { outline: 2px solid var(--amber-glow); outline-offset: 3px; }\n\n/* ---------- tooltip ---------------------------------------------------- */\n.tooltip {\n  position: fixed; max-width: 300px;\n  background: var(--panel-hi); color: var(--bone-soft);\n  border: 1px solid var(--hair);\n  border-radius: var(--radius); padding: 11px 14px;\n  font-size: 13px; line-height: 1.55; z-index: var(--z-tooltip); pointer-events: none;\n  /* a floating popover earns a lift; tightened blur + amber inset edge keeps it\n     in the inset-glow family rather than a soft generic drop shadow. */\n  box-shadow: inset 0 0 0 1px rgba(240,168,48,.10), 0 6px 18px rgba(0,0,0,.45);\n}\n.tooltip .tt-title {\n  font-family: var(--disp); font-weight: 700; font-size: 15px; letter-spacing: .4px;\n  text-transform: uppercase; color: var(--amber); margin-bottom: 5px;\n}\n\n/* ---------- accessibility floor ----------------------------------------\n   Base keyboard ring for every interactive element. High-traffic controls\n   (selects/inputs/toggle/slider) layer amber-glow rings above this. */\n:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; border-radius: var(--radius); }\n/* Kill ALL motion — transitions AND any animation — when the user asks. */\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    transition: none !important;\n    animation: none !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n/* ---------- responsive ------------------------------------------------- */\n@media (max-width: 640px) {\n  .topbar { flex-direction: column; align-items: flex-start; }\n  .actions { width: 100%; justify-content: flex-end; }\n  .status { min-width: 0; flex: 1; justify-content: flex-start; text-align: left; }\n  .field { flex-direction: column; align-items: stretch; gap: 8px; }\n  .field .ctl { justify-content: flex-start; }\n  .seg .opts { gap: 12px 18px; }\n  .width input[type=range] { width: 110px; }\n}\n","numLines":414,"startLine":1,"totalLines":414}}}
